ONLINE_API_PORT=4100
ONLINE_API_HOST=127.0.0.1
ONLINE_API_CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=POSmaster
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
POS_ORG_ID=default-org

# Optional: required only when the Tea Coop member modal sync button should pull
# fresh members/payments from an external Tea Coop API.
TEA_COOP_API_URL=
TEA_COOP_API_TOKEN=
TEA_COOP_MEMBERS_PATH=/members
TEA_COOP_PAYMENTS_PATH=/payments
