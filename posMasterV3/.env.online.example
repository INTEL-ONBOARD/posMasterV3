ONLINE_API_PORT=4100
ONLINE_API_HOST=127.0.0.1
ONLINE_API_CORS_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=POSmaster
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h
POS_ORG_ID=default-org

# Receipt printing:
# auto = try WiFi/network raw printer first, then fallback to installed OS printer
# system = use installed Windows/macOS printer queue only, best for USB printers
# network = use raw TCP printer only
POS_RECEIPT_PRINTER_MODE=auto
POS_RECEIPT_SYSTEM_PRINTER_NAME=
POS_RECEIPT_NETWORK_AUTODISCOVERY=true
POS_THERMAL_PRINTER_HOST=
POS_THERMAL_PRINTER_PORT=9100

# Tea Coop external API. URL/path defaults match the legacy integration found
# in develop/bugfix/system-audit; credentials should be supplied as secrets.
TEA_COOP_API_URL=https://api.teacoop.lk/api/v1
TEA_COOP_API_TOKEN=
TEA_COOP_AUTH_PATH=/thirdPartyLogin
TEA_COOP_USERNAME=
TEA_COOP_PASSWORD=
TEA_COOP_MEMBERS_PATH=/members/thirdparty-all-members-current-month
TEA_COOP_PAYMENTS_PATH=/members/{memberId}/thirdparty-monthly-payment
